<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_analytic_plan_form_view_inherit_obvio" model="ir.ui.view">
        <field name="name">account.analytic.plan.form.inherit.obvio</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="show_on_all_companies" invisible="parent_id"/>
            </xpath>
        </field>
    </record>

    <record id="account_analytic_plan_tree_view_inherit_obvio" model="ir.ui.view">
        <field name="name">account.analytic.plan.list.inherit.obvio</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_applicability']" position="after">
                <field name="show_on_all_companies" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
