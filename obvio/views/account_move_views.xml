<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
      <record id="view_move_tree_inherit_usd" model="ir.ui.view">
        <field name="name">account.move.tree.usd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='amount_total_in_currency_signed']" position="after">
                <field name="currency_usd_id" column_invisible="True"/>
                <field name="amount_untaxed_usd" sum="Total USD" 
                   widget="monetary" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_bill_tree_inherit_usd" model="ir.ui.view">
        <field name="name">account.move.bill.tree.usd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='amount_total_in_currency_signed']" position="after">
                <field name="currency_usd_id" column_invisible="True"/>
                <field name="amount_untaxed_usd" sum="Total USD" 
                   widget="monetary" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>