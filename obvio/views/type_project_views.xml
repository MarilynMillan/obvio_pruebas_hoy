<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <!-- Hereda name alias a la ficha del cliente  -->
        <record id="view_type_project_tree" model="ir.ui.view">
            <field name="name">type.project.tree</field>
            <field name="model">type.project</field>
            <field name="arch" type="xml">
                <list  string="Project Type">
                    <field name="name"/>
                    <field name="alias_name"/>
                    <field name="user_id"/>
                </list >
            </field>
        </record>

        <record id="view_type_project_form" model="ir.ui.view">
            <field name="name">type.project.form</field>
            <field name="model">type.project</field>
            <field name="arch" type="xml">
                <form string="Project Type">
                     <sheet>
                     
                             <div class="oe_title">
                                <label for="name" string="Project Type"/>
                                <h1>
                                    <field name="name" placeholder="Digital Project" field_id="name_0"/>
                                </h1>
                            </div>


                       <group>
                        <group>
                            <field name="alias_name"/>
                            <field name="user_id"/>
                            
                        </group>


                        <group>
                            <field name="company_id"/>
                        </group>
                         <group>
                          
                            <field name="note"/>
                        </group>

                    </group>
                     </sheet>
                </form>
            </field>
        </record>


        <record id="action_type_project" model="ir.actions.act_window">
            <field name="name">Project Type</field>
            <field name="res_model">type.project</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_type_project_tree"/>
            <field name="help" type="html">
                <p>
                    Manage project types
                </p>
            </field>
        </record>


        <menuitem id="menu_project_type" 
          name="Project Type" 
          parent="project.menu_project_config" 
          action="action_type_project" 
          sequence="12"/>


</odoo>