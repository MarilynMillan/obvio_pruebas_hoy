<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
         
        <!-- Hereda name alias a la ficha del cliente  -->
        <record id="view_zone_tienda_tree" model="ir.ui.view">
            <field name="name">zone.tienda.tree</field>
            <field name="model">zone.tienda</field>
            <field name="arch" type="xml">
                <list  string="Project Shop">
                    <field name="name"/>
                    <field name="tienda"/>
                    <field name="ubication_id" />
                </list >
            </field>
        </record>

        <record id="view_zone_tienda_form" model="ir.ui.view">
            <field name="name">zone.tienda.form</field>
            <field name="model">zone.tienda</field>
            <field name="arch" type="xml">
                <form string="Project Shop">
                     <sheet>
              

                        <group>
                            <field name="name"/>
                            <field name="tienda"/>
                            <field name="ubication_id" required="1"/>
                            
                        </group>




                  
                     </sheet>
                </form>
            </field>
        </record>


        <record id="action_zone_tienda" model="ir.actions.act_window">
            <field name="name">Stores</field>
            <field name="res_model">zone.tienda</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_zone_tienda_tree"/>
            <field name="help" type="html">
                <p>
                    Manage the project stores
                </p>
            </field>
        </record>


        <menuitem id="menu_zone_tienda" 
          name="Stores" 
          parent="project.menu_project_config" 
          action="action_zone_tienda" 
          sequence="12"/>



</odoo>